// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}
enum AccountStatus {
  ACTIVE
  INACTIVE
}
enum BillingStatus {
  UNPAID
  WAITING_VERIFICATION
  PAID
}
enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id         String   @id @default(uuid()) @db.VarChar(36)
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(150)
  password   String   @db.VarChar(255)
  role       Role     @default(CUSTOMER)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  accounts          ElectricityAccount[]
  verified_payments Payment[]            @relation("PaymentVerifier")

  @@map("users")
}

model ElectricityService {
  id            String   @id @default(uuid()) @db.VarChar(36)
  code          String   @unique @db.VarChar(20)
  name          String   @db.VarChar(100)
  power_va      Int
  price_per_kwh Decimal  @db.Decimal(12, 2)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  accounts ElectricityAccount[]

  @@map("electricity_services")
}

model ElectricityAccount {
  id                     String        @id @default(uuid()) @db.VarChar(36)
  user_id                String        @db.VarChar(36)
  electricity_service_id String        @db.VarChar(36)
  customer_number        String        @unique @db.VarChar(30)
  customer_name          String        @db.VarChar(100)
  address                String        @db.Text
  status                 AccountStatus @default(ACTIVE)
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  user                User               @relation(fields: [user_id], references: [id], onDelete: Restrict)
  electricity_service ElectricityService @relation(fields: [electricity_service_id], references: [id], onDelete: Restrict)
  billings            Billing[]

  @@map("electricity_accounts")
}

model Billing {
  id                     String        @id @default(uuid()) @db.VarChar(36)
  electricity_account_id String        @db.VarChar(36)
  period_month           Int
  period_year            Int
  previous_meter         Decimal       @db.Decimal(12, 2)
  current_meter          Decimal       @db.Decimal(12, 2)
  consumption            Decimal       @db.Decimal(12, 2)
  tariff_per_kwh         Decimal       @db.Decimal(12, 2)
  amount                 Decimal       @db.Decimal(12, 2)
  due_date               DateTime      @db.Date
  status                 BillingStatus @default(UNPAID)
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  electricity_account ElectricityAccount @relation(fields: [electricity_account_id], references: [id], onDelete: Restrict)
  payment             Payment?

  @@unique([electricity_account_id, period_month, period_year])
  @@map("billings")
}

model Payment {
  id            String        @id @default(uuid()) @db.VarChar(36)
  billing_id    String        @unique @db.VarChar(36)
  payment_proof String        @db.VarChar(255)
  status        PaymentStatus @default(PENDING)
  verified_by   String?       @db.VarChar(36)
  verified_at   DateTime?
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  billing  Billing @relation(fields: [billing_id], references: [id], onDelete: Restrict)
  verifier User?   @relation("PaymentVerifier", fields: [verified_by], references: [id], onDelete: Restrict)

  @@map("payments")
}
